        <mxCell id="PgS7k8zxbwXqaSmtQuQZ-19" value="Un pedido puede contener varios productos y un producto puede estar en varios pedidos. Entiendo que el producto es general digamos que sin numero de serie, sino tal vez esa entidad sería ejemplar (no sé cómo llamarlo)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;" vertex="1" parent="1">
