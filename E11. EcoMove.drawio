        <mxCell id="r2IMBNArnhVL_IYRh6hv-35" value="1:N" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="237.5" y="120" width="60" height="30" as="geometry" />
        </mxCell>
        <mxCell id="r2IMBNArnhVL_IYRh6hv-38" value="Un cliente puede realizar varios alquileres pero un alquiler sólo pueded estar realizado por un cliente (el titular del alquiler)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="-40" width="160" height="150" as="geometry" />
        </mxCell>
        <mxCell id="r2IMBNArnhVL_IYRh6hv-39" value="1:N" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="600" y="120" width="60" height="30" as="geometry" />
        </mxCell>
        <mxCell id="r2IMBNArnhVL_IYRh6hv-40" value="Un alquiler puede incluir varios vehículos (un coche, dos patinetes...) pero el vehículo sólo puede estar incluído en un alquiler y no en otro, por ejemplo el patinete X solo estará relacionado con un alquiler concreto del cliente X y hasta que no acabe su alquiler, no podrá alquilarlo otro cliente" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;" vertex="1" parent="1">
          <mxGeometry x="535" y="230" width="190" height="190" as="geometry" />
        </mxCell>
        <mxCell id="r2IMBNArnhVL_IYRh6hv-41" value="N:1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="960" y="120" width="60" height="30" as="geometry" />
        </mxCell>
        <mxCell id="r2IMBNArnhVL_IYRh6hv-42" value="Un vehículo sólo pertenece&lt;div&gt;&amp;nbsp;a una estación de carga pero en una estación de carga puede haber varios&amp;nbsp;&lt;div&gt;vehículos&lt;/div&gt;&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;" vertex="1" parent="1">
          <mxGeometry x="900" y="-60" width="160" height="150" as="geometry" />
        </mxCell>
        <mxCell id="r2IMBNArnhVL_IYRh6hv-43" value="1:N" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="1320" y="120" width="60" height="30" as="geometry" />
        </mxCell>
        <mxCell id="r2IMBNArnhVL_IYRh6hv-44" value="En una estación de carga se llevan a cabo varias revisiones técnicas pero las revisiones sólo se realizan en una única estación" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;" vertex="1" parent="1">
          <mxGeometry x="1270" y="-50" width="160" height="150" as="geometry" />
        </mxCell>
        <mxCell id="r2IMBNArnhVL_IYRh6hv-45" value="1:N" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="1220" y="295" width="60" height="30" as="geometry" />
        </mxCell>
        <mxCell id="r2IMBNArnhVL_IYRh6hv-46" value="En una estación de carga trabajan varios empleados, pero los empleados sólo trabajan en una estación de carga determinada" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;" vertex="1" parent="1">
          <mxGeometry x="1290" y="230" width="180" height="140" as="geometry" />
        </mxCell>
        <mxCell id="r2IMBNArnhVL_IYRh6hv-47" value="N:M" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="1220" y="540" width="60" height="30" as="geometry" />
        </mxCell>
        <mxCell id="r2IMBNArnhVL_IYRh6hv-48" value="Un empleado puede gestionar diferentes incidencias y las incidencias a su vez pueden ser gestionadas por diferentes empleados" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;" vertex="1" parent="1">
          <mxGeometry x="1360" y="500" width="180" height="140" as="geometry" />
        </mxCell>
        <mxCell id="r2IMBNArnhVL_IYRh6hv-49" value="&lt;ul&gt;&lt;li&gt;ID_GESTION (PK)&lt;/li&gt;&lt;li&gt;ID_EMPLEADO (FK)&lt;/li&gt;&lt;li&gt;ID_INCIDENCIA (FK)&lt;/li&gt;&lt;li&gt;ID_VEHICULO (FK)&lt;/li&gt;&lt;/ul&gt;" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;verticalAlign=middle;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="920" y="507.5" width="180" height="95" as="geometry" />
        </mxCell>
        <mxCell id="r2IMBNArnhVL_IYRh6hv-50" value="Las incidencias son de los vehículos, así que entiendo que la futura tabla intermedia debería apuntar tanto al empleado, a la incidencia y al vehículo implicado" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;" vertex="1" parent="1">
          <mxGeometry x="860" y="590" width="200" height="120" as="geometry" />
        </mxCell>
        <mxCell id="r2IMBNArnhVL_IYRh6hv-51" value="PUEDE TENER" style="shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;align=center;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
