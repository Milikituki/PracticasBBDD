          <mxGeometry x="140" y="295" width="60" height="30" as="geometry" />
        </mxCell>
        <mxCell id="r2IMBNArnhVL_IYRh6hv-55" value="Un cliente solo puede tener una suscipción mensual (como por ejemplo un cliente de netflix solo tiene un tipo de suscripción y no varias) pero un tipo de suscripción puede tener varios clientes" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;" vertex="1" parent="1">
